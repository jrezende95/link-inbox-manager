# Copy to .env.local. Never commit .env.local.

# openai | anthropic | gemini
LINK_MODEL_PROVIDER=openai
LINK_MODEL=choose-during-onboarding
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

LINK_POLICY_PATH=./config/policy.local.json
LINK_DATABASE_PATH=./data/link.sqlite
LINK_BROWSER_PROFILE=./browser-profile
LINK_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
LINK_LOG_LEVEL=info

# These remain false until the user explicitly approves launch after Sheet validation.
LINK_VALIDATION_MODE=true
LINK_AUTO_SEND=false
LINK_AUTO_MARK_READ=false

# Optional unattended Google Sheets logging. A coding-agent connector may be used
# instead while operation remains supervised and auto-send is disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
LINK_GOOGLE_TOKEN_PATH=./.link/google-oauth.json
LINK_GOOGLE_SHEET_ID=
LINK_GOOGLE_SHEET_TAB=Validation
